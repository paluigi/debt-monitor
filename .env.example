# --- MongoDB ---
# Local docker container (see README): mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=debt_monitor

# --- API keys ---
FRED_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=

# Optional: forward proxy URL (user:pass@host:port) for hosts that block
# residential/datacenter egress (e.g. www.sec.gov document archives). Unused by default.
WEBSHARE_PROXY=

# --- Daily schedule (local time) ---
SCHEDULE_HOUR=6
SCHEDULE_MINUTE=0
SCHEDULE_TZ=Europe/Rome
